; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bare Steel"
config/version="0.2.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.05, 0.047, 0.043, 1)
boot_splash/image="res://assets/images/boot_splash.png"
boot_splash/fullsize=true
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
AudioDirector="*res://scripts/audio_director.gd"
CombatFX="*res://scripts/combat_fx.gd"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_signal=1
gdscript/warnings/shadowed_variable=1

[editor_plugins]

enabled=PackedStringArray("res://addons/kickback/plugin.cfg")

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Weapons"
3d_physics/layer_3="Characters"
3d_physics/layer_4="Active Ragdoll"
3d_physics/layer_5="Godot Ragdoll"

[physics]

3d/physics_engine="Jolt Physics"
; Web/WASM performance tune: verified stable under bot and vision tests.
jolt_physics_3d/solver/velocity_iterations=4
jolt_physics_3d/solver/position_iterations=1

